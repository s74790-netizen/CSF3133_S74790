/* Page styling */
body {
    font-family: Arial, sans-serif;
    background-color: #f5f8fa;
    color: #222;
    margin: 30px;
}

h2 {
    color: #1f5a7a;
    margin-bottom: 16px;
}

/* Form card styling */
form {
    background-color: #ffffff;
    border: 1px solid #d6dee5;
    border-radius: 6px;
    padding: 18px 20px;
    max-width: 340px;
    margin-bottom: 16px;
}

label {
    display: inline-block;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 6px;
}

input[type="text"] {
    width: 100%;
    box-sizing: border-box;
    padding: 7px 10px;
    margin-bottom: 12px;
    border: 1px solid #b8c4ce;
    border-radius: 4px;
    font-size: 14px;
}

/* Button styling and hover effect */
button {
    background-color: #2374a5;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    font-size: 13px;
    cursor: pointer;
    margin-right: 6px;
    margin-top: 4px;
}

button:hover {
    background-color: #175378;
}

/* Result and timestamp text */
#result {
    font-weight: bold;
    font-size: 16px;
    margin: 10px 0 4px 0;
}

#timestamp {
    font-weight: bold;
    font-size: 14px;
    color: green;
    margin: 0 0 14px 0;
}

/* Grade table styling: borders, padding, header background */
#tableContainer {
    margin-top: 14px;
}

table {
    border-collapse: collapse;
    min-width: 240px;
    background-color: #ffffff;
}

th, td {
    border: 1px solid #d0d7de;
    padding: 8px 16px;
    text-align: center;
}

th {
    background-color: #1b4f72;
    color: #ffffff;
    font-weight: bold;
}